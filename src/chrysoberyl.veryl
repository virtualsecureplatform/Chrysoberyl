/// Chrysoberyl is the simulation/debug-facing compact, in-order
/// RV32IC_Zba_Zbb_Zcb implementation. Both memories are combinational-read;
/// writes are committed by the environment on `i_clk` when `o_ram_we` is set.
pub module Chrysoberyl #(
    param USE_HISTORY_PREDICTION: bbool = false,
    param ROM_SIZE_BYTES        : u32   = 16384,
    param RESET_REGISTERS       : bbool = true,
) (
    i_clk           : input  clock         ,
    i_rst           : input  reset         ,
    i_rom_data      : input  logic<32>     ,
    o_rom_addr      : output logic<$clog2(ROM_SIZE_BYTES) - 2>,
    i_ram_read_data : input  logic<32>     ,
    o_ram_addr      : output logic<10>     ,
    o_ram_write_data: output logic<32>     ,
    o_ram_we        : output logic<4>      ,
    o_finish        : output logic         ,
    o_x             : output logic<32> [32],
) {
    const ROM_ADDRESS_WIDTH: u32 = $clog2(ROM_SIZE_BYTES);

    // Architectural state and IF/ID pipeline register.
    var r_x      : logic<32> [32];
    var r_pc     : logic<ROM_ADDRESS_WIDTH>;
    var r_id_inst: logic<32>     ;
    var r_id_pc  : logic<ROM_ADDRESS_WIDTH>;
    var r_id_len : logic<3>      ;
    var r_id_pred_taken: logic   ;
    var r_id_bht_index : logic<6>;
    var r_finish : logic         ;
    var r_fetch_cross: logic     ;
    var r_fetch_low16: logic<16> ;
    var r_fetch_pc: logic<ROM_ADDRESS_WIDTH>;

    // ID/EX pipeline register.
    var r_ex_valid       : logic    ;
    var r_ex_a           : logic<32>;
    var r_ex_b           : logic<32>;
    var r_ex_store_data  : logic<32>;
    var r_ex_rd          : logic<5> ;
    var r_ex_alu_op      : logic<5> ;
    var r_ex_branch      : logic<3> ;
    var r_ex_mem_read    : logic    ;
    var r_ex_mem_write   : logic    ;
    var r_ex_mem_size    : logic<2> ;
    var r_ex_mem_unsigned: logic    ;
    var r_ex_reg_write   : logic    ;
    var r_ex_wb_sel      : logic<2> ;
    var r_ex_pc4         : logic<32>;
    var r_ex_jump_addr   : logic<32>;
    var r_ex_pred_taken  : logic    ;
    var r_ex_bht_index   : logic<6> ;

    // EX/MEM pipeline register.
    var r_mem_valid     : logic    ;
    var r_mem_alu       : logic<32>;
    var r_mem_store_data: logic<32>;
    var r_mem_rd        : logic<5> ;
    var r_mem_read      : logic    ;
    var r_mem_write     : logic    ;
    var r_mem_size      : logic<2> ;
    var r_mem_unsigned  : logic    ;
    var r_mem_reg_write : logic    ;
    var r_mem_wb_sel    : logic<2> ;
    var r_mem_pc4       : logic<32>;

    // Decode signals.
    var d_rs1         : logic<5> ;
    var d_rs2         : logic<5> ;
    var d_rd          : logic<5> ;
    var d_a           : logic<32>;
    var d_b           : logic<32>;
    var d_store_data  : logic<32>;
    var d_alu_op      : logic<5> ;
    var d_branch      : logic<3> ;
    var d_mem_read    : logic    ;
    var d_mem_write   : logic    ;
    var d_mem_size    : logic<2> ;
    var d_mem_unsigned: logic    ;
    var d_reg_write   : logic    ;
    var d_wb_sel      : logic<2> ;
    var d_uses_rs1    : logic    ;
    var d_uses_rs2    : logic    ;
    var d_zba_shift   : logic<2> ;
    var d_imm         : logic<32>;
    var d_pc          : logic<32>;
    var d_jump_addr   : logic<32>;

    var w_ex_alu      : logic<32>;
    var w_ex_arithmetic: logic<34>;
    var w_ex_add_sub  : logic<32>;
    var w_ex_subtract : logic    ;
    var w_ex_signed_lt: logic    ;
    var w_ex_unsigned_lt: logic  ;
    var w_ex_branch_ok: logic    ;
    var w_ex_control  : logic    ;
    var w_ex_taken    : logic    ;
    var w_ex_redirect : logic    ;
    var w_ex_redirect_addr: logic<32>;
    var w_ex_forward_data: logic<32>;
    var w_count_leading: logic<32>;
    var w_count_trailing: logic<32>;
    var w_population_count: logic<32>;
    var w_popcount_pair: logic<2> [16];
    var w_popcount_nibble: logic<3> [8];
    var w_popcount_byte: logic<4> [4];
    var w_popcount_half: logic<5> [2];
    var w_orc_b: logic<32>;
    var w_wb_data     : logic<32>;
    var w_shifted_data: logic<32>;
    var w_load_stall  : logic    ;
    var w_fetch_inst  : logic<32>;
    var w_fetch_len   : logic<3> ;
    var w_fetch_half  : logic<16>;
    var w_fetch_word  : logic<32>;
    var w_c_imm       : logic<32>;
    var w_c_rd        : logic<5> ;
    var w_fetch_pc    : logic<32>;
    var w_fetch_target: logic<32>;
    var w_fetch_pred_taken: logic;
    var w_fetch_ctrl_imm: logic<32>;
    var w_fetch_bht_index: logic<6>;
    var w_fetch_is_branch: logic;
    var w_fetch_is_jump: logic;
    var w_history_pred_taken: logic;

    function count_trailing_byte (
        bits: input logic<8>,
    ) -> logic<4> {
        var ret: logic<4>;
        ret = 8;
        if bits[7] { ret = 7; }
        if bits[6] { ret = 6; }
        if bits[5] { ret = 5; }
        if bits[4] { ret = 4; }
        if bits[3] { ret = 3; }
        if bits[2] { ret = 2; }
        if bits[1] { ret = 1; }
        if bits[0] { ret = 0; }
        return ret;
    }

    function count_leading_byte (
        bits: input logic<8>,
    ) -> logic<4> {
        var ret: logic<4>;
        ret = 8;
        if bits[0] { ret = 7; }
        if bits[1] { ret = 6; }
        if bits[2] { ret = 5; }
        if bits[3] { ret = 4; }
        if bits[4] { ret = 3; }
        if bits[5] { ret = 2; }
        if bits[6] { ret = 1; }
        if bits[7] { ret = 0; }
        return ret;
    }

    /// Shared 32-bit Kogge-Stone arithmetic datapath. Subtraction uses
    /// a + ~b + 1. When subtraction is selected, bits 32 and 33 return
    /// unsigned and signed less-than, allowing ADD, SUB, comparisons,
    /// MIN/MAX, and branches to share the tree.
    function add_sub_prefix (
        a       : input logic<32>,
        b       : input logic<32>,
        subtract: input logic,
    ) -> logic<34> {
        var b_effective: logic<32>;
        var bit_p      : logic<32>;
        var g0         : logic<32>;
        var p1         : logic<32>;
        var g1         : logic<32>;
        var p2         : logic<32>;
        var g2         : logic<32>;
        var p4         : logic<32>;
        var g4         : logic<32>;
        var prop8      : logic<32>;
        var gen8       : logic<32>;
        var gen16      : logic<32>;
        var ret        : logic<34>;

        b_effective = b ^ {subtract repeat 32};
        bit_p = a ^ b_effective;
        g0 = a & b_effective;
        // Seed the prefix tree with the +1 required by two's-complement SUB.
        g0[0] = g0[0] | (bit_p[0] & subtract);

        p1 = bit_p;
        g1 = g0;
        for i in 1..32 {
            p1[i] = bit_p[i] & bit_p[i - 1];
            g1[i] = g0[i] | (bit_p[i] & g0[i - 1]);
        }

        p2 = p1;
        g2 = g1;
        for i in 2..32 {
            p2[i] = p1[i] & p1[i - 2];
            g2[i] = g1[i] | (p1[i] & g1[i - 2]);
        }

        p4 = p2;
        g4 = g2;
        for i in 4..32 {
            p4[i] = p2[i] & p2[i - 4];
            g4[i] = g2[i] | (p2[i] & g2[i - 4]);
        }

        prop8 = p4;
        gen8 = g4;
        for i in 8..32 {
            prop8[i] = p4[i] & p4[i - 8];
            gen8[i] = g4[i] | (p4[i] & g4[i - 8]);
        }

        gen16 = gen8;
        for i in 16..32 {
            gen16[i] = gen8[i] | (prop8[i] & gen8[i - 16]);
        }

        ret[0] = bit_p[0] ^ subtract;
        for i in 1..32 {
            ret[i] = bit_p[i] ^ gen16[i - 1];
        }
        // A carry out means no borrow for unsigned subtraction.
        ret[32] = ~gen16[31];
        // Opposite-sign operands cannot overflow this signed comparison.
        if a[31] != b[31] {
            ret[33] = a[31];
        } else {
            ret[33] = ret[31];
        }
        return ret;
    }

    assign o_rom_addr = r_pc[ROM_ADDRESS_WIDTH - 1:2];

    always_comb {
        // Memory stage and external RAM port.
        // Alexandrite exposes the low ten bits of the byte address directly.
        // The RAM implementation is responsible for selecting the addressed word.
        o_ram_addr       = r_mem_alu[9:0];
        o_ram_write_data = r_mem_store_data;
        o_ram_we         = 0;
        if r_mem_valid && r_mem_write {
            case r_mem_size {
                2'd0: o_ram_we = 4'b0001 << r_mem_alu[1:0];
                2'd1: {
                    if r_mem_alu[1] {
                        o_ram_we = 4'b1100;
                    } else {
                        o_ram_we = 4'b0011;
                    }
                }
                default: o_ram_we = 4'b1111;
            }
            case r_mem_size {
                2'd0   : o_ram_write_data = r_mem_store_data << (r_mem_alu[1:0] * 8);
                2'd1   : o_ram_write_data = r_mem_store_data << (r_mem_alu[1] * 16);
                default: o_ram_write_data = r_mem_store_data;
            }
        }

        w_wb_data      = r_mem_alu;
        w_shifted_data = i_ram_read_data >> (r_mem_alu[1:0] * 8);
        if r_mem_wb_sel == 2'd1 {
            case r_mem_size {
                2'd0: {
                    w_wb_data = {24'b0, w_shifted_data[7:0]};
                    if !r_mem_unsigned && w_wb_data[7] {
                        w_wb_data = {w_wb_data[7] repeat 24, w_wb_data[7:0]};
                    }
                }
                2'd1: {
                    if r_mem_alu[1] {
                        w_wb_data = {16'b0, i_ram_read_data[31:16]};
                    } else {
                        w_wb_data = {16'b0, i_ram_read_data[15:0]};
                    }
                    if !r_mem_unsigned && w_wb_data[15] {
                        w_wb_data = {w_wb_data[15] repeat 16, w_wb_data[15:0]};
                    }
                }
                default: w_wb_data = i_ram_read_data;
            }
        } else if r_mem_wb_sel == 2'd2 {
            w_wb_data = r_mem_pc4;
        }
    }

    always_comb {
        // Single-cycle Zbb count and byte-granule helpers.
        if r_ex_a[31:24] != 0 {
            w_count_leading = {28'b0, count_leading_byte(r_ex_a[31:24])};
        } else if r_ex_a[23:16] != 0 {
            w_count_leading = 8 + {28'b0, count_leading_byte(r_ex_a[23:16])};
        } else if r_ex_a[15:8] != 0 {
            w_count_leading = 16 + {28'b0, count_leading_byte(r_ex_a[15:8])};
        } else if r_ex_a[7:0] != 0 {
            w_count_leading = 24 + {28'b0, count_leading_byte(r_ex_a[7:0])};
        } else {
            w_count_leading = 32;
        }
        if r_ex_a[7:0] != 0 {
            w_count_trailing = {28'b0, count_trailing_byte(r_ex_a[7:0])};
        } else if r_ex_a[15:8] != 0 {
            w_count_trailing = 8 + {28'b0, count_trailing_byte(r_ex_a[15:8])};
        } else if r_ex_a[23:16] != 0 {
            w_count_trailing = 16 + {28'b0, count_trailing_byte(r_ex_a[23:16])};
        } else if r_ex_a[31:24] != 0 {
            w_count_trailing = 24 + {28'b0, count_trailing_byte(r_ex_a[31:24])};
        } else {
            w_count_trailing = 32;
        }
        for i in 0..16 {
            w_popcount_pair[i] = {1'b0, r_ex_a[2 * i]} + {1'b0, r_ex_a[2 * i + 1]};
        }
        for i in 0..8 {
            w_popcount_nibble[i] = {1'b0, w_popcount_pair[2 * i]} + {1'b0, w_popcount_pair[2 * i + 1]};
        }
        for i in 0..4 {
            w_popcount_byte[i] = {1'b0, w_popcount_nibble[2 * i]} + {1'b0, w_popcount_nibble[2 * i + 1]};
        }
        for i in 0..2 {
            w_popcount_half[i] = {1'b0, w_popcount_byte[2 * i]} + {1'b0, w_popcount_byte[2 * i + 1]};
        }
        w_population_count = {26'b0, 1'b0, w_popcount_half[0]} + {26'b0, 1'b0, w_popcount_half[1]};
        w_orc_b = 0;
        if r_ex_a[7:0]   != 0 { w_orc_b[7:0]   = 8'hff; }
        if r_ex_a[15:8]  != 0 { w_orc_b[15:8]  = 8'hff; }
        if r_ex_a[23:16] != 0 { w_orc_b[23:16] = 8'hff; }
        if r_ex_a[31:24] != 0 { w_orc_b[31:24] = 8'hff; }

        // Execute stage. Operations 11 through 30 include RV32 Zbb.
        // Opcodes 24 through 31 all consume subtraction or its comparison flags.
        // Keeping this as a two-bit decode avoids placing a priority tree in
        // front of every bit of the shared arithmetic datapath.
        w_ex_subtract = r_ex_alu_op[4] && r_ex_alu_op[3];
        w_ex_arithmetic = add_sub_prefix(
            r_ex_a,
            r_ex_b,
            w_ex_subtract,
        );
        w_ex_add_sub = w_ex_arithmetic[31:0];
        w_ex_unsigned_lt = w_ex_arithmetic[32];
        w_ex_signed_lt = w_ex_arithmetic[33];
        case r_ex_alu_op {
            5'd1: w_ex_alu = (r_ex_a << r_ex_b[4:0]) | (r_ex_a >> (5'd0 - r_ex_b[4:0]));
            5'd2: w_ex_alu = r_ex_a & r_ex_b;
            5'd3: w_ex_alu = r_ex_a | r_ex_b;
            5'd4: w_ex_alu = r_ex_a ^ r_ex_b;
            5'd5: w_ex_alu = (r_ex_a >> r_ex_b[4:0]) | (r_ex_a << (5'd0 - r_ex_b[4:0]));
            5'd6: w_ex_alu = w_orc_b;
            5'd7 : w_ex_alu = r_ex_a << r_ex_b[4:0];
            5'd8 : w_ex_alu = r_ex_a >> r_ex_b[4:0];
            5'd9 : w_ex_alu = $signed(r_ex_a) >>> r_ex_b[4:0];
            5'd10: w_ex_alu = r_ex_b;
            5'd11: w_ex_alu = r_ex_a & ~r_ex_b;
            5'd12: w_ex_alu = r_ex_a | ~r_ex_b;
            5'd13: w_ex_alu = ~(r_ex_a ^ r_ex_b);
            5'd14: w_ex_alu = w_count_leading;
            5'd15: w_ex_alu = w_count_trailing;
            5'd16: w_ex_alu = w_population_count;
            5'd17: w_ex_alu = {r_ex_a[7:0], r_ex_a[15:8], r_ex_a[23:16], r_ex_a[31:24]};
            5'd24: w_ex_alu = w_ex_add_sub;
            5'd25: w_ex_alu = {31'b0, w_ex_signed_lt};
            5'd26: w_ex_alu = {31'b0, w_ex_unsigned_lt};
            5'd27: {
                if w_ex_signed_lt {
                    w_ex_alu = r_ex_a;
                } else {
                    w_ex_alu = r_ex_b;
                }
            }
            5'd28: {
                if w_ex_unsigned_lt {
                    w_ex_alu = r_ex_a;
                } else {
                    w_ex_alu = r_ex_b;
                }
            }
            5'd29: {
                if w_ex_signed_lt {
                    w_ex_alu = r_ex_b;
                } else {
                    w_ex_alu = r_ex_a;
                }
            }
            5'd30: {
                if w_ex_unsigned_lt {
                    w_ex_alu = r_ex_b;
                } else {
                    w_ex_alu = r_ex_a;
                }
            }
            5'd21: w_ex_alu = {r_ex_a[7] repeat 24, r_ex_a[7:0]};
            5'd22: w_ex_alu = {r_ex_a[15] repeat 16, r_ex_a[15:0]};
            5'd23: w_ex_alu = {16'b0, r_ex_a[15:0]};
            default: w_ex_alu = w_ex_add_sub;
        }
        w_ex_branch_ok = false;
        case r_ex_branch {
            3'd1   : w_ex_branch_ok = r_ex_a == r_ex_b;
            3'd2   : w_ex_branch_ok = r_ex_a != r_ex_b;
            3'd3   : w_ex_branch_ok = w_ex_signed_lt;
            3'd4   : w_ex_branch_ok = !w_ex_signed_lt;
            3'd5   : w_ex_branch_ok = w_ex_unsigned_lt;
            3'd6   : w_ex_branch_ok = !w_ex_unsigned_lt;
            default: w_ex_branch_ok = false;
        }
        w_ex_control = r_ex_valid && (r_ex_branch != 0 || r_ex_wb_sel == 2'd2);
        w_ex_taken = r_ex_valid && ((r_ex_branch != 0 && w_ex_branch_ok)
            || (r_ex_branch == 0 && r_ex_wb_sel == 2'd2));
        w_ex_redirect = w_ex_control && (w_ex_taken != r_ex_pred_taken);
        if w_ex_taken {
            if r_ex_branch != 0 {
                w_ex_redirect_addr = r_ex_jump_addr;
            } else {
                // JAL and JALR already put their base and immediate on the
                // shared arithmetic datapath. Reuse that result as the target;
                // clearing bit 0 is required by JALR and is a no-op for JAL.
                w_ex_redirect_addr = {w_ex_add_sub[31:1], 1'b0};
            }
        } else {
            w_ex_redirect_addr = r_ex_pc4;
        }
        if r_ex_wb_sel == 2'd2 {
            w_ex_forward_data = r_ex_pc4;
        } else {
            w_ex_forward_data = w_ex_alu;
        }
    }

    always_comb {
        // Fetch one instruction from the 32-bit ROM port. Compressed
        // instructions are expanded to their RV32I equivalents before decode.
        // A 32-bit instruction beginning at address 2 mod 4 takes a second
        // fetch cycle so its two halves can be joined.
        w_fetch_word  = i_rom_data;
        w_fetch_half  = i_rom_data[15:0];
        w_fetch_inst  = i_rom_data;
        w_fetch_len   = 4;
        w_c_imm       = 0;
        w_c_rd        = 0;
        if r_fetch_cross {
            w_fetch_word = {i_rom_data[15:0], r_fetch_low16};
            w_fetch_inst = w_fetch_word;
        } else {
            if r_pc[1] {
                w_fetch_half = i_rom_data[31:16];
            }
            if w_fetch_half[1:0] != 2'b11 {
                w_fetch_len  = 2;
                w_fetch_inst = 0;
                case w_fetch_half[1:0] {
                    2'b00: case w_fetch_half[15:13] {
                        // C.ADDI4SPN
                        3'b000: {
                            w_c_rd  = {2'b01, w_fetch_half[4:2]};
                            w_c_imm = {22'b0, w_fetch_half[10:7], w_fetch_half[12:11], w_fetch_half[5], w_fetch_half[6], 2'b0};
                            w_fetch_inst = {w_c_imm[11:0], 5'd2, 3'b000, w_c_rd, 7'b0010011};
                        }
                        // C.LW
                        3'b010: {
                            w_c_rd  = {2'b01, w_fetch_half[4:2]};
                            w_c_imm = {25'b0, w_fetch_half[5], w_fetch_half[12:10], w_fetch_half[6], 2'b0};
                            w_fetch_inst = {w_c_imm[11:0], {2'b01, w_fetch_half[9:7]}, 3'b010, w_c_rd, 7'b0000011};
                        }
                        // Zcb byte/halfword loads and stores
                        3'b100: {
                            w_c_rd = {2'b01, w_fetch_half[4:2]};
                            case w_fetch_half[12:10] {
                                // C.LBU
                                3'b000: {
                                    w_c_imm = {30'b0, w_fetch_half[5], w_fetch_half[6]};
                                    w_fetch_inst = {w_c_imm[11:0], {2'b01, w_fetch_half[9:7]}, 3'b100, w_c_rd, 7'b0000011};
                                }
                                // C.LHU / C.LH
                                3'b001: {
                                    w_c_imm = {30'b0, w_fetch_half[5], 1'b0};
                                    if w_fetch_half[6] {
                                        w_fetch_inst = {w_c_imm[11:0], {2'b01, w_fetch_half[9:7]}, 3'b001, w_c_rd, 7'b0000011};
                                    } else {
                                        w_fetch_inst = {w_c_imm[11:0], {2'b01, w_fetch_half[9:7]}, 3'b101, w_c_rd, 7'b0000011};
                                    }
                                }
                                // C.SB
                                3'b010: {
                                    w_c_imm = {30'b0, w_fetch_half[5], w_fetch_half[6]};
                                    w_fetch_inst = {w_c_imm[11:5], w_c_rd, {2'b01, w_fetch_half[9:7]}, 3'b000, w_c_imm[4:0], 7'b0100011};
                                }
                                // C.SH
                                3'b011: {
                                    w_c_imm = {30'b0, w_fetch_half[5], 1'b0};
                                    w_fetch_inst = {w_c_imm[11:5], w_c_rd, {2'b01, w_fetch_half[9:7]}, 3'b001, w_c_imm[4:0], 7'b0100011};
                                    // Bit 6 is ignored for unsupported encodings.
                                }
                                default: w_fetch_inst = 0;
                            }
                        }
                        // C.SW
                        3'b110: {
                            w_c_imm = {25'b0, w_fetch_half[5], w_fetch_half[12:10], w_fetch_half[6], 2'b0};
                            w_fetch_inst = {w_c_imm[11:5], {2'b01, w_fetch_half[4:2]}, {2'b01, w_fetch_half[9:7]}, 3'b010, w_c_imm[4:0], 7'b0100011};
                        }
                        default: w_fetch_inst = 0;
                    }
                    2'b01: case w_fetch_half[15:13] {
                        // C.ADDI / C.NOP
                        3'b000: {
                            w_c_imm = {w_fetch_half[12] repeat 27, w_fetch_half[6:2]};
                            w_fetch_inst = {w_c_imm[11:0], w_fetch_half[11:7], 3'b000, w_fetch_half[11:7], 7'b0010011};
                        }
                        // C.JAL (RV32 only)
                        3'b001: {
                            w_c_imm = {w_fetch_half[12] repeat 21, w_fetch_half[8], w_fetch_half[10:9], w_fetch_half[6], w_fetch_half[7], w_fetch_half[2], w_fetch_half[11], w_fetch_half[5:3], 1'b0};
                            w_fetch_inst = {w_c_imm[20], w_c_imm[10:1], w_c_imm[11], w_c_imm[19:12], 5'd1, 7'b1101111};
                        }
                        // C.LI
                        3'b010: {
                            w_c_imm = {w_fetch_half[12] repeat 27, w_fetch_half[6:2]};
                            w_fetch_inst = {w_c_imm[11:0], 5'd0, 3'b000, w_fetch_half[11:7], 7'b0010011};
                        }
                        // C.ADDI16SP / C.LUI
                        3'b011: {
                            if w_fetch_half[11:7] == 5'd2 {
                                w_c_imm = {w_fetch_half[12] repeat 23, w_fetch_half[4:3], w_fetch_half[5], w_fetch_half[2], w_fetch_half[6], 4'b0};
                                w_fetch_inst = {w_c_imm[11:0], 5'd2, 3'b000, 5'd2, 7'b0010011};
                            } else {
                                w_c_imm = {w_fetch_half[12] repeat 15, w_fetch_half[6:2], 12'b0};
                                w_fetch_inst = {w_c_imm[31:12], w_fetch_half[11:7], 7'b0110111};
                            }
                        }
                        // C.SRLI/C.SRAI/C.ANDI/C.SUB/XOR/OR/AND
                        3'b100: {
                            w_c_rd = {2'b01, w_fetch_half[9:7]};
                            case w_fetch_half[11:10] {
                                2'b00: {
                                    w_fetch_inst = {7'b0000000, w_fetch_half[6:2], w_c_rd, 3'b101, w_c_rd, 7'b0010011};
                                }
                                2'b01: {
                                    w_fetch_inst = {7'b0100000, w_fetch_half[6:2], w_c_rd, 3'b101, w_c_rd, 7'b0010011};
                                }
                                2'b10: {
                                    w_c_imm = {w_fetch_half[12] repeat 27, w_fetch_half[6:2]};
                                    w_fetch_inst = {w_c_imm[11:0], w_c_rd, 3'b111, w_c_rd, 7'b0010011};
                                }
                                default: {
                                    if w_fetch_half[12] {
                                        case w_fetch_half[6:2] {
                                            // C.ZEXT.B
                                            5'b11000: w_fetch_inst = {12'h0ff, w_c_rd, 3'b111, w_c_rd, 7'b0010011};
                                            // C.SEXT.B (Zbb)
                                            5'b11001: w_fetch_inst = {7'b0110000, 5'b00100, w_c_rd, 3'b001, w_c_rd, 7'b0010011};
                                            // C.ZEXT.H (Zbb)
                                            5'b11010: w_fetch_inst = {7'b0000100, 5'b00000, w_c_rd, 3'b100, w_c_rd, 7'b0110011};
                                            // C.SEXT.H (Zbb)
                                            5'b11011: w_fetch_inst = {7'b0110000, 5'b00101, w_c_rd, 3'b001, w_c_rd, 7'b0010011};
                                            // C.NOT
                                            5'b11101: w_fetch_inst = {12'hfff, w_c_rd, 3'b100, w_c_rd, 7'b0010011};
                                            default: w_fetch_inst = 0;
                                        }
                                    } else {
                                        case w_fetch_half[6:5] {
                                            2'b00: w_fetch_inst = {7'b0100000, {2'b01, w_fetch_half[4:2]}, w_c_rd, 3'b000, w_c_rd, 7'b0110011};
                                            2'b01: w_fetch_inst = {7'b0000000, {2'b01, w_fetch_half[4:2]}, w_c_rd, 3'b100, w_c_rd, 7'b0110011};
                                            2'b10: w_fetch_inst = {7'b0000000, {2'b01, w_fetch_half[4:2]}, w_c_rd, 3'b110, w_c_rd, 7'b0110011};
                                            2'b11: w_fetch_inst = {7'b0000000, {2'b01, w_fetch_half[4:2]}, w_c_rd, 3'b111, w_c_rd, 7'b0110011};
                                        }
                                    }
                                }
                            }
                        }
                        // C.J
                        3'b101: {
                            w_c_imm = {w_fetch_half[12] repeat 21, w_fetch_half[8], w_fetch_half[10:9], w_fetch_half[6], w_fetch_half[7], w_fetch_half[2], w_fetch_half[11], w_fetch_half[5:3], 1'b0};
                            w_fetch_inst = {w_c_imm[20], w_c_imm[10:1], w_c_imm[11], w_c_imm[19:12], 5'd0, 7'b1101111};
                        }
                        // C.BEQZ / C.BNEZ
                        3'b110, 3'b111: {
                            w_c_imm = {w_fetch_half[12] repeat 24, w_fetch_half[6:5], w_fetch_half[2], w_fetch_half[11:10], w_fetch_half[4:3], 1'b0};
                            w_fetch_inst = {w_c_imm[12], w_c_imm[10:5], 5'd0, {2'b01, w_fetch_half[9:7]}, {2'b00, w_fetch_half[13]}, w_c_imm[4:1], w_c_imm[11], 7'b1100011};
                        }
                    }
                    2'b10: case w_fetch_half[15:13] {
                        // C.SLLI
                        3'b000: {
                            w_fetch_inst = {7'b0000000, w_fetch_half[6:2], w_fetch_half[11:7], 3'b001, w_fetch_half[11:7], 7'b0010011};
                        }
                        // C.LWSP
                        3'b010: {
                            w_c_imm = {24'b0, w_fetch_half[3:2], w_fetch_half[12], w_fetch_half[6:4], 2'b0};
                            w_fetch_inst = {w_c_imm[11:0], 5'd2, 3'b010, w_fetch_half[11:7], 7'b0000011};
                        }
                        // C.JR/C.MV/C.EBREAK/C.JALR/C.ADD
                        3'b100: {
                            if !w_fetch_half[12] {
                                if w_fetch_half[6:2] == 0 {
                                    w_fetch_inst = {12'b0, w_fetch_half[11:7], 3'b000, 5'd0, 7'b1100111};
                                } else {
                                    w_fetch_inst = {7'b0000000, w_fetch_half[6:2], 5'd0, 3'b000, w_fetch_half[11:7], 7'b0110011};
                                }
                            } else {
                                if w_fetch_half[6:2] == 0 {
                                    w_fetch_inst = {12'b0, w_fetch_half[11:7], 3'b000, 5'd1, 7'b1100111};
                                } else {
                                    w_fetch_inst = {7'b0000000, w_fetch_half[6:2], w_fetch_half[11:7], 3'b000, w_fetch_half[11:7], 7'b0110011};
                                }
                            }
                        }
                        // C.SWSP
                        3'b110: {
                            w_c_imm = {24'b0, w_fetch_half[8:7], w_fetch_half[12:9], 2'b0};
                            w_fetch_inst = {w_c_imm[11:5], w_fetch_half[6:2], 5'd2, 3'b010, w_c_imm[4:0], 7'b0100011};
                        }
                        default: w_fetch_inst = 0;
                    }
                    default: w_fetch_inst = 0;
                }
            }
        }
    }

    always_comb {
        // Static branch prediction: backward conditional branches are taken,
        // forward conditional branches are not taken, and direct jumps are
        // always taken. Indirect JALR-family jumps continue to resolve in EX.
        if r_fetch_cross {
            w_fetch_pc = r_fetch_pc as 32;
        } else {
            w_fetch_pc = r_pc as 32;
        }
        w_fetch_ctrl_imm  = 0;
        w_fetch_target    = w_fetch_pc;
        w_fetch_bht_index = w_fetch_pc[6:1];
        w_fetch_is_branch = false;
        w_fetch_is_jump   = false;
        if w_fetch_inst[6:0] == 7'b1100011 {
            w_fetch_ctrl_imm = {w_fetch_inst[31] repeat 20, w_fetch_inst[7], w_fetch_inst[30:25], w_fetch_inst[11:8], 1'b0};
            w_fetch_target = w_fetch_pc + w_fetch_ctrl_imm;
            w_fetch_is_branch = true;
        } else if w_fetch_inst[6:0] == 7'b1101111 {
            w_fetch_ctrl_imm = {w_fetch_inst[31] repeat 12, w_fetch_inst[19:12], w_fetch_inst[20], w_fetch_inst[30:21], 1'b0};
            w_fetch_target = w_fetch_pc + w_fetch_ctrl_imm;
            w_fetch_is_jump = true;
        }
    }

    always_comb {
        // Decode defaults.
        d_rs1          = r_id_inst[19:15];
        d_rs2          = r_id_inst[24:20];
        d_rd           = r_id_inst[11:7];
        d_a            = 0;
        d_b            = 0;
        d_store_data   = 0;
        d_alu_op       = 0;
        d_branch       = 0;
        d_mem_read     = false;
        d_mem_write    = false;
        d_mem_size     = 2'd2;
        d_mem_unsigned = false;
        d_reg_write    = false;
        d_wb_sel       = 0;
        d_uses_rs1     = false;
        d_uses_rs2     = false;
        d_zba_shift    = 0;
        d_imm          = 0;
        d_pc           = r_id_pc as 32;
        case r_id_inst[6:0] {
            7'b0110111: {
                d_imm       = {r_id_inst[31:12], 12'b0};
                d_b         = d_imm;
                d_alu_op    = 5'd10;
                d_reg_write = true;
            }
            7'b0010111: {
                d_imm       = {r_id_inst[31:12], 12'b0};
                d_a         = d_pc;
                d_b         = d_imm;
                d_reg_write = true;
            }
            7'b1101111: {
                d_imm       = {r_id_inst[31] repeat 12, r_id_inst[19:12], r_id_inst[20], r_id_inst[30:21], 1'b0};
                d_a         = d_pc;
                d_b         = d_imm;
                d_reg_write = true;
                d_wb_sel    = 2'd2;
            }
            7'b1100111: {
                d_imm       = {r_id_inst[31] repeat 20, r_id_inst[31:20]};
                d_b         = d_imm;
                d_uses_rs1  = true;
                d_reg_write = true;
                d_wb_sel    = 2'd2;
            }
            7'b1100011: {
                d_imm      = {r_id_inst[31] repeat 20, r_id_inst[7], r_id_inst[30:25], r_id_inst[11:8], 1'b0};
                d_a        = d_pc;
                d_b        = d_imm;
                d_uses_rs1 = true;
                d_uses_rs2 = true;
                // Branch comparisons use the shared subtraction flags.
                d_alu_op   = 5'd31;
                case r_id_inst[14:12] {
                    3'd0   : d_branch = 1;
                    3'd1   : d_branch = 2;
                    3'd4   : d_branch = 3;
                    3'd5   : d_branch = 4;
                    3'd6   : d_branch = 5;
                    3'd7   : d_branch = 6;
                    default: d_branch = 0;
                }
            }
            7'b0000011: {
                d_imm       = {r_id_inst[31] repeat 20, r_id_inst[31:20]};
                d_b         = d_imm;
                d_uses_rs1  = true;
                d_mem_read  = true;
                d_reg_write = true;
                d_wb_sel    = 1;
                case r_id_inst[14:12] {
                    3'd0: d_mem_size = 0;
                    3'd1: d_mem_size = 1;
                    3'd2: d_mem_size = 2;
                    3'd4: {
                        d_mem_size     = 0;
                        d_mem_unsigned = true;
                    }
                    3'd5: {
                        d_mem_size     = 1;
                        d_mem_unsigned = true;
                    }
                    default: d_mem_size = 2;
                }
            }
            7'b0100011: {
                d_imm       = {r_id_inst[31] repeat 20, r_id_inst[31:25], r_id_inst[11:7]};
                d_b         = d_imm;
                d_uses_rs1  = true;
                d_uses_rs2  = true;
                d_mem_write = true;
                case r_id_inst[14:12] {
                    3'd0   : d_mem_size = 0;
                    3'd1   : d_mem_size = 1;
                    3'd2   : d_mem_size = 2;
                    default: d_mem_size = 2;
                }
            }
            7'b0010011: {
                d_imm       = {r_id_inst[31] repeat 20, r_id_inst[31:20]};
                d_b         = d_imm;
                d_uses_rs1  = true;
                d_reg_write = true;
                if r_id_inst[31:25] == 7'b0110000 && r_id_inst[14:12] == 3'b001 {
                    // Zbb count and sign-extension operations.
                    case r_id_inst[24:20] {
                        5'b00000: d_alu_op = 14; // CLZ
                        5'b00001: d_alu_op = 15; // CTZ
                        5'b00010: d_alu_op = 16; // CPOP
                        5'b00100: d_alu_op = 21; // SEXT.B
                        5'b00101: d_alu_op = 22; // SEXT.H
                        default: d_alu_op = 0;
                    }
                } else if r_id_inst[31:25] == 7'b0110000 && r_id_inst[14:12] == 3'b101 {
                    d_b      = {27'b0, r_id_inst[24:20]};
                    d_alu_op = 5; // RORI
                } else if r_id_inst[31:20] == 12'b001010000111 && r_id_inst[14:12] == 3'b101 {
                    d_alu_op = 6; // ORC.B
                } else if r_id_inst[31:20] == 12'b011010011000 && r_id_inst[14:12] == 3'b101 {
                    d_alu_op = 17; // REV8 (RV32 encoding)
                } else {
                    case r_id_inst[14:12] {
                        3'd0: d_alu_op = 0;
                        3'd2: d_alu_op = 25;
                        3'd3: d_alu_op = 26;
                        3'd4: d_alu_op = 4;
                        3'd6: d_alu_op = 3;
                        3'd7: d_alu_op = 2;
                        3'd1: d_alu_op = 7;
                        3'd5: {
                            if r_id_inst[30] {
                                d_alu_op = 9;
                            } else {
                                d_alu_op = 8;
                            }
                        }
                        default: d_alu_op = 0;
                    }
                }
            }
            7'b0110011: {
                d_uses_rs1  = true;
                d_uses_rs2  = true;
                d_reg_write = true;
                if r_id_inst[31:25] == 7'b0100000 {
                    case r_id_inst[14:12] {
                        3'b000: d_alu_op = 24; // SUB
                        3'b100: d_alu_op = 13; // XNOR
                        3'b101: d_alu_op = 9;  // SRA
                        3'b110: d_alu_op = 12; // ORN
                        3'b111: d_alu_op = 11; // ANDN
                        default: d_alu_op = 0;
                    }
                } else if r_id_inst[31:25] == 7'b0110000 {
                    case r_id_inst[14:12] {
                        3'b001: d_alu_op = 1; // ROL
                        3'b101: d_alu_op = 5; // ROR
                        default: d_alu_op = 0;
                    }
                } else if r_id_inst[31:25] == 7'b0010000 {
                    // Zba fixed-shift address generation reuses the adder.
                    case r_id_inst[14:12] {
                        3'b010: d_zba_shift = 1; // SH1ADD
                        3'b100: d_zba_shift = 2; // SH2ADD
                        3'b110: d_zba_shift = 3; // SH3ADD
                        default: d_alu_op = 0;
                    }
                } else if r_id_inst[31:25] == 7'b0000101 {
                    case r_id_inst[14:12] {
                        3'b100: d_alu_op = 27; // MIN
                        3'b101: d_alu_op = 28; // MINU
                        3'b110: d_alu_op = 29; // MAX
                        3'b111: d_alu_op = 30; // MAXU
                        default: d_alu_op = 0;
                    }
                } else if r_id_inst[31:25] == 7'b0000100 && r_id_inst[24:20] == 0
                    && r_id_inst[14:12] == 3'b100 {
                    d_alu_op = 23; // ZEXT.H (RV32 encoding)
                } else {
                    case r_id_inst[14:12] {
                        3'd0: {
                            if r_id_inst[30] {
                                d_alu_op = 24;
                            } else {
                                d_alu_op = 0;
                            }
                        }
                        3'd1: d_alu_op = 7;
                        3'd2: d_alu_op = 25;
                        3'd3: d_alu_op = 26;
                        3'd4: d_alu_op = 4;
                        3'd5: {
                            if r_id_inst[30] {
                                d_alu_op = 9;
                            } else {
                                d_alu_op = 8;
                            }
                        }
                        3'd6   : d_alu_op = 3;
                        3'd7   : d_alu_op = 2;
                        default: d_alu_op = 0;
                    }
                }
            }
            default: d_reg_write = false;
        }
        if d_uses_rs1 {
            if d_rs1 == 0 {
                d_a = 0;
            } else {
                d_a = r_x[d_rs1];
            }
        }
        if d_uses_rs2 {
            if d_rs2 == 0 {
                d_store_data = 0;
            } else {
                d_store_data = r_x[d_rs2];
            }
            if r_id_inst[6:0] == 7'b0110011 || r_id_inst[6:0] == 7'b1100011 {
                d_b = d_store_data;
            }
        }
        // Bypass EX ALU results and the writeback result. Loads are interlocked below.
        if d_uses_rs1 && r_ex_valid && r_ex_reg_write && !r_ex_mem_read && r_ex_rd != 0 && d_rs1 == r_ex_rd {
            d_a = w_ex_forward_data;
        }
        if d_uses_rs2 && r_ex_valid && r_ex_reg_write && !r_ex_mem_read && r_ex_rd != 0 && d_rs2 == r_ex_rd {
            d_store_data = w_ex_forward_data;
            if r_id_inst[6:0] == 7'b0110011 || r_id_inst[6:0] == 7'b1100011 {
                d_b = w_ex_forward_data;
            }
        }
        if d_uses_rs1 && r_mem_valid && r_mem_reg_write && r_mem_rd != 0 && d_rs1 == r_mem_rd
            && !(r_ex_valid && r_ex_reg_write && !r_ex_mem_read && r_ex_rd != 0 && d_rs1 == r_ex_rd) {
            d_a = w_wb_data;
        }
        if d_uses_rs2 && r_mem_valid && r_mem_reg_write && r_mem_rd != 0 && d_rs2 == r_mem_rd
            && !(r_ex_valid && r_ex_reg_write && !r_ex_mem_read && r_ex_rd != 0 && d_rs2 == r_ex_rd) {
            d_store_data = w_wb_data;
            if r_id_inst[6:0] == 7'b0110011 || r_id_inst[6:0] == 7'b1100011 {
                d_b = w_wb_data;
            }
        }
        // Apply the Zba shift after bypassing so forwarded rs1 values are used.
        if d_zba_shift != 0 {
            d_a = d_a << d_zba_shift;
        }
        // Branch ALU operands hold the compared registers, so retain a
        // separately registered PC-relative target. Jumps reuse the execute
        // arithmetic result and do not need a decode-stage target adder.
        d_jump_addr = d_pc + d_imm;
        w_load_stall = r_ex_valid && r_ex_mem_read && r_ex_rd != 0
            && ((d_uses_rs1 && d_rs1 == r_ex_rd) || (d_uses_rs2 && d_rs2 == r_ex_rd));
    }

    if USE_HISTORY_PREDICTION :g_history_prediction {
        var r_bht_valid  : logic    [64];
        var r_bht_counter: logic<2> [64];

        always_comb {
            if r_bht_valid[w_fetch_bht_index] {
                w_history_pred_taken = r_bht_counter[w_fetch_bht_index][1];
            } else {
                w_history_pred_taken = w_fetch_ctrl_imm[31];
            }
        }

        always_ff (i_clk, i_rst) {
            if_reset {
                for i in 0..64 {
                    r_bht_valid[i]   = false;
                    r_bht_counter[i] = 0;
                }
            } else if r_ex_valid && r_ex_branch != 0 {
                if !r_bht_valid[r_ex_bht_index] {
                    r_bht_valid[r_ex_bht_index] = true;
                    if w_ex_branch_ok {
                        r_bht_counter[r_ex_bht_index] = 2'b10;
                    } else {
                        r_bht_counter[r_ex_bht_index] = 2'b01;
                    }
                } else {
                    case r_bht_counter[r_ex_bht_index] {
                        2'b00: if w_ex_branch_ok { r_bht_counter[r_ex_bht_index] = 2'b01; }
                        2'b01: {
                            if w_ex_branch_ok {
                                r_bht_counter[r_ex_bht_index] = 2'b10;
                            } else {
                                r_bht_counter[r_ex_bht_index] = 2'b00;
                            }
                        }
                        2'b10: {
                            if w_ex_branch_ok {
                                r_bht_counter[r_ex_bht_index] = 2'b11;
                            } else {
                                r_bht_counter[r_ex_bht_index] = 2'b01;
                            }
                        }
                        2'b11: if !w_ex_branch_ok { r_bht_counter[r_ex_bht_index] = 2'b10; }
                    }
                }
            }
        }
    } else :g_static_prediction {
        always_comb {
            w_history_pred_taken = w_fetch_ctrl_imm[31];
        }
    }

    always_comb {
        w_fetch_pred_taken = false;
        if w_fetch_is_branch {
            w_fetch_pred_taken = w_history_pred_taken;
        } else if w_fetch_is_jump {
            w_fetch_pred_taken = true;
        }
    }

    always_ff (i_clk, i_rst) {
        if_reset {
            r_pc              = 0;
            r_id_inst         = 0;
            r_id_pc           = 0;
            r_id_len          = 4;
            r_id_pred_taken   = false;
            r_id_bht_index    = 0;
            r_finish          = false;
            r_fetch_cross     = false;
            r_fetch_low16     = 0;
            r_fetch_pc        = 0;
            r_ex_valid        = false;
            r_mem_valid       = false;
            r_ex_a            = 0;
            r_ex_b            = 0;
            r_ex_store_data   = 0;
            r_ex_rd           = 0;
            r_ex_alu_op       = 0;
            r_ex_branch       = 0;
            r_ex_mem_read     = false;
            r_ex_mem_write    = false;
            r_ex_mem_size     = 0;
            r_ex_mem_unsigned = false;
            r_ex_reg_write    = false;
            r_ex_wb_sel       = 0;
            r_ex_pc4          = 0;
            r_ex_jump_addr    = 0;
            r_ex_pred_taken   = false;
            r_ex_bht_index    = 0;
            r_mem_alu         = 0;
            r_mem_store_data  = 0;
            r_mem_rd          = 0;
            r_mem_read        = false;
            r_mem_write       = false;
            r_mem_size        = 0;
            r_mem_unsigned    = false;
            r_mem_reg_write   = false;
            r_mem_wb_sel      = 0;
            r_mem_pc4         = 0;
            if RESET_REGISTERS {
                for i in 0..32 {
                    r_x[i] = 0;
                }
            } else {
                r_x[0] = 0;
            }
        } else {
            if r_mem_valid && r_mem_reg_write && r_mem_rd != 0 {
                r_x[r_mem_rd] = w_wb_data;
            }
            r_x[0]           = 0;
            r_mem_valid      = r_ex_valid;
            r_mem_alu        = w_ex_alu;
            r_mem_store_data = r_ex_store_data;
            r_mem_rd         = r_ex_rd;
            r_mem_read       = r_ex_mem_read;
            r_mem_write      = r_ex_mem_write;
            r_mem_size       = r_ex_mem_size;
            r_mem_unsigned   = r_ex_mem_unsigned;
            r_mem_reg_write  = r_ex_reg_write;
            r_mem_wb_sel     = r_ex_wb_sel;
            r_mem_pc4        = r_ex_pc4;
            if r_mem_valid && r_mem_write && r_mem_alu == 4 && r_mem_store_data != 0 {
                r_finish = true;
            }
            if w_ex_redirect {
                r_pc       = w_ex_redirect_addr[ROM_ADDRESS_WIDTH - 1:0];
                r_id_inst  = 0;
                r_id_pc    = 0;
                r_id_len   = 4;
                r_id_pred_taken = false;
                r_id_bht_index = 0;
                r_fetch_cross = false;
                r_ex_valid = false;
                r_ex_pred_taken = false;
                r_ex_bht_index = 0;
            } else if w_load_stall {
                r_ex_valid = false;
                r_ex_pred_taken = false;
                r_ex_bht_index = 0;
            } else {
                r_ex_valid        = true;
                r_ex_a            = d_a;
                r_ex_b            = d_b;
                r_ex_store_data   = d_store_data;
                r_ex_rd           = d_rd;
                r_ex_alu_op       = d_alu_op;
                r_ex_branch       = d_branch;
                r_ex_mem_read     = d_mem_read;
                r_ex_mem_write    = d_mem_write;
                r_ex_mem_size     = d_mem_size;
                r_ex_mem_unsigned = d_mem_unsigned;
                r_ex_reg_write    = d_reg_write;
                r_ex_wb_sel       = d_wb_sel;
                r_ex_pc4          = (r_id_pc as 32) + (r_id_len as 32);
                r_ex_jump_addr    = d_jump_addr;
                r_ex_pred_taken   = r_id_pred_taken;
                r_ex_bht_index    = r_id_bht_index;
                if r_fetch_cross {
                    r_id_inst     = w_fetch_inst;
                    r_id_pc       = r_fetch_pc;
                    r_id_len      = 4;
                    r_id_pred_taken = w_fetch_pred_taken;
                    r_id_bht_index = w_fetch_bht_index;
                    if w_fetch_pred_taken {
                        r_pc = w_fetch_target[ROM_ADDRESS_WIDTH - 1:0];
                    } else {
                        r_pc = r_pc + (2 as ROM_ADDRESS_WIDTH);
                    }
                    r_fetch_cross = false;
                } else if r_pc[1] && w_fetch_half[1:0] == 2'b11 {
                    r_id_inst      = 0;
                    r_id_pc        = 0;
                    r_id_len       = 4;
                    r_id_pred_taken = false;
                    r_id_bht_index = 0;
                    r_fetch_low16  = w_fetch_half;
                    r_fetch_pc     = r_pc;
                    r_fetch_cross  = true;
                    r_pc           = r_pc + (2 as ROM_ADDRESS_WIDTH);
                } else {
                    r_id_inst = w_fetch_inst;
                    r_id_pc   = r_pc;
                    r_id_len  = w_fetch_len;
                    r_id_pred_taken = w_fetch_pred_taken;
                    r_id_bht_index = w_fetch_bht_index;
                    if w_fetch_pred_taken {
                        r_pc = w_fetch_target[ROM_ADDRESS_WIDTH - 1:0];
                    } else {
                        r_pc = r_pc + (w_fetch_len as ROM_ADDRESS_WIDTH);
                    }
                }
            }
        }
    }

    assign o_finish = r_finish;
    for i in 0..32 :g_register_output {
        assign o_x[i] = r_x[i];
    }
}

/// ChrysoberylCore is the synthesis-oriented wrapper. Simulation-only register
/// and finish outputs are left unconnected so synthesis can remove their logic.
pub module ChrysoberylCore #(
    param USE_HISTORY_PREDICTION: bbool = false,
    param ROM_SIZE_BYTES        : u32   = 16384,
) (
    i_clk           : input  clock         ,
    i_rst           : input  reset         ,
    i_rom_data      : input  logic<32>     ,
    o_rom_addr      : output logic<$clog2(ROM_SIZE_BYTES) - 2>,
    i_ram_read_data : input  logic<32>     ,
    o_ram_addr      : output logic<10>     ,
    o_ram_write_data: output logic<32>     ,
    o_ram_we        : output logic<4>      ,
) {
    var unused_finish: logic;
    var unused_x: logic<32> [32];

    inst u_impl: Chrysoberyl #(
        USE_HISTORY_PREDICTION: USE_HISTORY_PREDICTION,
        ROM_SIZE_BYTES        : ROM_SIZE_BYTES,
        RESET_REGISTERS       : false,
    ) (
        i_clk           : i_clk,
        i_rst           : i_rst,
        i_rom_data      : i_rom_data,
        o_rom_addr      : o_rom_addr,
        i_ram_read_data : i_ram_read_data,
        o_ram_addr      : o_ram_addr,
        o_ram_write_data: o_ram_write_data,
        o_ram_we        : o_ram_we,
        o_finish        : unused_finish,
        o_x             : unused_x,
    );
}
